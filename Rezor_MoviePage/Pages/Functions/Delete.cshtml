@page
@model Rezor_MoviePage.Pages.Functions.DeleteModel

<div class="container-my">
    <form method="post">

        <div class="row-7">
            <div class="col-url">
                <div class="img" style="text-align:center;">
                    <img class="img-fluid" src="@Model!.Movie.URL" alt="@Model!.Movie.Title" style="
                max-width: 40%;
                max-height: 380px;" />
                </div>
            </div>
            <div class="col-description" style="text-align:center;">
                <div class="description">
                    <div class="text-bolt">
                        <b>Название: @Model.Movie.Title</b>
                    </div>
                    <p>Описание: @Model.Movie.Description</p>
                    @* <span>Стоимость Билета: @Model.Movie.Cost &#8381;</span> *@
                </div>
            </div>
            <div class="btn-primary" style="text-align:center;">
                <button class="btn btn-primary" type="submit">Удалить</button>
                <a class="btn btn-primary" asp-page="/Functions/Services" style="
                position: relative;
                width: auto;
                height: 40px;
                text-align: center;">
                    Назад
                </a>
            </div>
        
        <div hidden="hidden">
            <input asp-for=Movie.Id type="number"/>
        </div>
        </div>
    </form>
</div>
