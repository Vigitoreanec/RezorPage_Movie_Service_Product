@page
@* @using Rezor_MoviePage.Pages *@
@model Rezor_MoviePage.Pages.Functions.PrivacyModel


<div class="container" style="
display: flex;
justify-content: center;
min-height: calc(95vh - 65px);
flex-direction: row;flex-wrap: wrap;
align-content: center;">
    <div class="input-group mb-3" style="display:flex; align-items: center; justify-content: space-around; margin-top: 10px; position: fixed;">
        <a asp-page="./Add" class="btn btn-outline-success my-2 my-sm-0" style="border-radius:5px;">Добавить</a>
        <form method="post" class="form-inline my-2 my-lg-0" style="display:flex;">
            <input type="text" asp-for="SearchTitleMovie" class="form-control mr-sm-2" type="search" placeholder="Search" aria-label="Search" style="margin-right: 20px;">
            <button class="btn btn-outline-success my-2 my-sm-0" type="submit">Поиск</button>
        </form>
    </div>
    @foreach (var service in Model.movies)
    {
        <div class="card" style="width: 18rem; margin-right: 10px; margin-top: 10px;">
            <img class="card-img-top" src="@service.URL" alt="Card image" style="width: 286px; height: 190px">
            <div class="card-body">
                <h5 class="card-title">@service.Title</h5>
                <p class="card-text">@service.Description</p>
                @* <p class="card-text"><b>Стоимость:</b> @service.Cost &#8381;</p> *@
                <div class="d-flex justify-content-between" style="flex-direction:column;">
                    <a asp-page="./Details" asp-route-id="@service.Id" class="btn btn-primary" style="
                    position: relative;
                    margin: 10px auto;
                    text-align: center;">
                        Заказать Услугу
                    </a>
                    <a class="btn btn-primary" asp-page="./Delete"  asp-route-id="@service.Id" style="
                    position: relative;
                    margin: 10px auto;
                    text-align: center;">
                        Удалить
                    </a>
                    <a asp-page="./Edit" asp-route-id="@service.Id" class="btn btn-primary" style="
                    position: relative;
                    margin: 10px auto;
                    text-align: center;">
                        Редактировать Услугу
                    </a>
                    
                </div>
            </div>
        </div>
    }
</div>