@page
@model Rezor_MoviePage.Pages.IndexModel

<div class="container" style="display: flex; justify-content: center; min-height: calc(100vh - 80px); ">
    <div class="jumbotron" style="position:center;">
        <h2 class="display-3">Маникюр</h2>
        <h3 class="display-3">Лист Услуг Мастера:</h3>
        @foreach(var movie in Model.MovieContext.Movies)
        {
            <p style="text-align:center">@movie.Title</p>
        }
    </div>
</div>
