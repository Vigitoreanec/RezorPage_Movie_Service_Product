@page
@* @using Rezor_MoviePage.Pages *@
@model Rezor_MoviePage.Pages.Functions.PrivacyModel


<div class="container" style="
display: flex;
justify-content: center;
min-height: calc(95vh - 65px);
flex-direction: row;flex-wrap: wrap;
align-content: center;">
    <div class="input-group mb-3" style="display:flex; align-items: center; justify-content: space-around; margin-top: 10px; position: relative;">
        <a asp-page="./Add" class="btn btn-outline-success my-2 my-sm-0" style="border-radius:5px;">Добавить</a>
        <form method="post" class="form-inline my-2 my-lg-0" style="display:flex;">
            <input type="date" min="@Model.MinDate" max="@Model.MaxDate" asp-for="SearchDateMovie" value="@Model.Selected" style=" margin-right: 10%;" />
            <input type="text" asp-for="SearchTitleMovie" class="form-control mr-sm-2" type="search" placeholder="Search" aria-label="Search" style="margin-right: 20px;">
            <button class="btn btn-outline-success my-2 my-sm-0" type="submit">Поиск</button>
        </form>
    </div>
    @if(Model.Shedules is not null)
    {
        @if(Model.Shedules.Count() == 0)
        {
            <div style="padding-bottom: 15%;">
                <h2 style=" margin: 30% 0; ">По вашему запросу Ничего не Найдено!</h2>
            </div>
        }
        else
        {


            @foreach (var service in Model.Shedules)
            {
                <div class="card" style="width: 18rem; margin-right: 10px; margin-top: 10px; --bs-card-spacer-y: 0.3rem;
            --bs-card-spacer-x: 1rem;">
            <img class="card-img-top" src="@service.Movie.URL" alt="Card image" style="width: 286px; height: 190px">
            <div class="card-body">
                <h5 class="card-title"><b>Название: </b>@service.Movie.Title</h5>
                <p class="card-text"><b>Описание: </b>@service.Movie.Description</p>
                <p class="card-text"><b>Время Начала: </b>@Model.ChangeFormatTime(@service.StartFilm.Hour) - @Model.ChangeFormatTime(@service.StartFilm.Minute)</p>
                <p class="card-text"><b>Стоимость:</b> @service.Cost &#8381;</p>
                <div class="d-flex justify-content-between" style="flex-direction:column;">
                    <a asp-page="./Details" asp-route-id="@service.SheduleId" class="btn btn-primary" style="
                    position: relative;
                    margin: 10px auto;
                    text-align: center;">
                        Заказать Услугу
                    </a>
                   @*  <a class="btn btn-primary" asp-page="./Delete" asp-route-id="@service.Movie.Id" style="
                    position: relative;
                    margin: 10px auto;
                    text-align: center;">
                        Удалить
                    </a> *@
                    @* <a asp-page="./Edit" asp-route-id="@service.Movie.Id" class="btn btn-primary" style="
                    position: relative;
                    margin: 10px auto;
                    text-align: center;">
                        Редактировать Услугу
                    </a> *@
                    
                </div>
            </div>
            </div>
            }
        }
    }
</div>