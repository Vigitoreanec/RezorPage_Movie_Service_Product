@page
@* @using Rezor_MoviePage.Data *@
@using Rezor_MoviePage.Pages
@model PrivacyModel

<div class="container" style="
display: flex;
justify-content: center;
min-height: calc(95vh - 65px);
flex-direction: row;flex-wrap: wrap;
align-content: center;">
    <a asp-page="/Functions/Add" class="btn add-card">Добавить</a>
    @foreach (var service in Model.MovieContext.Movies)
    {
        <div class="card" style="width: 18rem; margin-right: 10px; margin-top: 10px;">
            <img class="card-img-top" src="@service.URL" alt="Card image" style="width: 286px; height: 190px">
            <div class="card-body">
                <h5 class="card-title">@service.Title</h5>
                <p class="card-text">@service.Description</p>
                <p class="card-text"><b>Стоимость:</b> @service.Cost &#8381;</p>
                <div class="d-flex justify-content-between" style="flex-direction:column;">
                    <a asp-page="./Functions/Details" asp-route-id="@service.Id" class="btn btn-primary" style="
                    position: relative;
                    margin: 10px auto;
                    text-align: center;">
                        Заказать Услугу</a>
                    <a asp-page="./Functions/Delete" asp-route-id="@service.Id" class="btn btn-primary" style="
                    position: relative;
                    margin: 10px auto;
                    text-align: center;">
                        Удалить Услугу</a>
                    <a asp-page="/Functions/Edit" asp-route-id="@service.Id" class="btn btn-primary" style="
                    position: relative;
                    margin: 10px auto;
                    text-align: center;">
                        Редактировать Услугу
                    </a>
                    
                </div>
            </div>
        </div>
    }
</div>