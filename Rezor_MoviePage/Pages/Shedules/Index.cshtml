@page
@model Rezor_MoviePage.Pages.Shedules.IndexModel

@{
    ViewData["Title"] = "Расписание";
}

<h1>Расписание</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Shedule[0].StartFilm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Shedule[0].EndFilm)
            </th>
            <th>
                @Html.DisplayName("Расписание")
            </th>
            <th>
                @Html.DisplayName("Зал кинотеатра")
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Shedule[0].Cost)
            </th>
            <th>

            </th>
            
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Shedule) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.StartFilm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EndFilm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Movie.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HallCinema.NumberHall)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Cost)
            </td>
            <td>
                    @if (User.Identity.IsAuthenticated && User.IsInRole("admin"))
                    {
                <a asp-page="./Edit" asp-route-id="@item.SheduleId">Edit</a> 
                <a asp-page="./Details" asp-route-id="@item.SheduleId">Details</a> 
                <a asp-page="./Delete" asp-route-id="@item.SheduleId">Delete</a>
                    }
            </td>
        </tr>
}
    </tbody>
</table>
